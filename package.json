{
  "name": "pixel-studio",
  "version": "0.1.0-preview.0",
  "private": true,
  "description": "Pixel Studio – original raster image editor for Windows (engineering preview)",
  "license": "UNLICENSED",
  "type": "module",
  "main": "apps/desktop/dist/main.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:editor": "vite build --config apps/editor/vite.config.ts",
    "build:desktop": "node apps/desktop/build.mjs",
    "build": "npm run build:editor && npm run build:desktop",
    "start": "npm run build && electron .",
    "dev:editor": "vite --config apps/editor/vite.config.ts",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.1",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.50.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
