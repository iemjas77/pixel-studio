{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ps/raster": ["packages/raster-ref/src/index.ts"],
      "@ps/document": ["packages/document/src/index.ts"],
      "@ps/commands": ["packages/commands/src/index.ts"],
      "@ps/codecs": ["packages/codecs/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src", "tests", "apps/*/*.ts", "*.ts"]
}
